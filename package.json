{
  "name": "oira666_pi-free-swarm",
  "version": "0.3.2",
  "description": "Pi extension that launches a leaderless swarm of pi agents that self-organise on a shared wall, with a live web board.",
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "index.ts",
    "src/",
    "ui_dist/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi",
    "swarm",
    "multi-agent",
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gee666/pi-free-swarm.git"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --import tsx/esm --test --test-concurrency=4 \"test/**/*.test.ts\"",
    "test:ui": "vitest run --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:size": "node scripts/check-size.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm run format:check && npm run check:size && npm test && npm run test:ui && npm run check:package",
    "lab": "node --import tsx/esm src/lab/cli.ts",
    "test:lab": "node --import tsx/esm --test \"test/lab/**/*.test.ts\""
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.87.1",
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@fontsource/inter": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.2.6",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.3",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.540.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "tsx": "^4.23.13",
    "zod": "^4.6.7"
  },
  "overrides": {}
}
